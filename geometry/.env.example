# Geometry service configuration. Copy to geometry/.env (git-ignored); run_geometry_service.sh loads it.
# Paths below are examples.

# --- environment and weights
GEOMETRY_PYTHON=/opt/envs/atas-gpu/bin/python   # Python with torch + geometry/environment.snapshot.txt
GEOMETRY_MODEL_ROOT=/data/models                    # contains pi3x/ and sam3/sam3.pt
# GEOMETRY_PI3_MODEL=/data/models/pi3x           # overrides GEOMETRY_MODEL_ROOT/pi3x
# GEOMETRY_SAM3_CHECKPOINT=/data/models/sam3/sam3.pt

# --- storage
GEOMETRY_HOT_ROOT=/var/tmp/geometry-service         # fast local disk: worlds, observations, jobs
# GEOMETRY_ARCHIVE_ROOT=/nas/geometry-archive      # optional copy of committed worlds

# --- network
GEOMETRY_HOST=127.0.0.1
GEOMETRY_PORT=18300
# GEOMETRY_API_TOKEN=change-me                     # set whenever the port is reachable remotely

# --- GPUs. Jobs are admitted by free memory, so shared cards are fine.
GEOMETRY_GPU_IDS=0                                  # cards the service may use, e.g. 0,1,2,3
GEOMETRY_MAX_GPUS=1                                 # concurrent jobs (at most one per card)
# GEOMETRY_RECON_MIN_FREE_MIB=24576                # free memory a card needs to start a reconstruction
# GEOMETRY_RESIDENT_MODELS=1                       # keep Pi3X/SAM3 loaded per card between jobs

# --- reconstruction (defaults are the low-VRAM configuration, peak ~20 GB)
# GEOMETRY_LOW_VRAM=1                               # windowed Pi3X, CPU-offloaded SAM3 frames
# GEOMETRY_PI3_VO_CHUNK=48                         # Pi3X window; 0 = whole clip in one pass (80 GB cards)
# GEOMETRY_PI3_VO_OVERLAP=6

# --- Apple Silicon (macOS). Defaults: GEOMETRY_DEVICE=mps on darwin, cuda elsewhere.
# GEOMETRY_DEVICE=mps                               # mps | cpu | cuda
# GEOMETRY_MPS_DTYPE=float32                        # Pi3X precision on MPS (float32 selected by evidence, AC10)
# GEOMETRY_SAM3_BACKEND=cpp                         # sam3.cpp (Metal); the PyTorch SAM3 path needs CUDA
# GEOMETRY_SAM3CPP_BIN=/path/to/atas_sam3_track     # built from geometry/native/sam3cpp (pinned commit in SAM3CPP_COMMIT)
# GEOMETRY_SAM3_CHECKPOINT=/path/to/sam3-f16.ggml   # GGML weights (model chosen by AC15/A8)
# GEOMETRY_SAM3CPP_NO_GPU=0
# Operation: unified memory is shared with every app. A reconstruction is admitted only when
# 24 GiB (GEOMETRY_RECON_MIN_FREE_MIB) is available; close memory-heavy apps (VMs, browsers, IDEs,
# other AI apps) before running the service, otherwise jobs wait at "waiting_gpu".
