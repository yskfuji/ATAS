+int sam3_tracker_add_instance_from_mask(sam3_tracker& tracker, sam3_state& state,
+                                        const sam3_model& model,
+                                        const sam3_mask& mask) {
+    // Same as sam3_tracker_add_instance, but the memory is initialised from a given binary mask instead of a PVS result.
+    const int D = model.hparams.neck_dim;
+    const int mask_hw = sam3_eff_feat_size(state, model.hparams) * 4;
+    if (mask.data.empty() || mask.width <= 0 || mask.height <= 0) return -1;
+
+    int inst_id = tracker.next_inst_id++;
+    int fi = tracker.frame_index - 1;
+    if (fi < 0) fi = 0;
+
+    std::vector<float> synth_logits(mask_hw * mask_hw);
+    for (int y = 0; y < mask_hw; ++y) {
+        int sy = y * mask.height / mask_hw;
+        for (int x = 0; x < mask_hw; ++x) {
+            int sx = x * mask.width / mask_hw;
+            synth_logits[y * mask_hw + x] = (mask.data[sy * mask.width + sx] > 127) ? 6.0f : -6.0f;
+        }
+    }
+    const float obj_score = 10.0f;  // the mask comes from a detector: the object is present
+    if (!sam3_encode_memory(tracker, state, model, inst_id, synth_logits.data(), mask_hw, mask_hw, fi, true, obj_score)) {
+        fprintf(stderr, "%s: failed to encode memory for instance %d\n", __func__, inst_id);
+        return -1;
+    }
+    std::vector<float> op(D, 0.0f);   // no decoder token for a given mask: zero object pointer, as when PVS yields none
+    sam3_store_obj_ptr(tracker, model, inst_id, op.data(), fi);
+
+    sam3_masklet ml;
+    ml.instance_id = inst_id;
+    ml.first_frame = fi;
+    ml.last_seen = fi;
+    ml.last_score = 1.0f;
+    ml.confirmed = true;
+    ml.mds_sum = 1;
+    tracker.masklets.push_back(std::move(ml));
+    return inst_id;
+}
+
 int sam3_tracker_frame_index(const sam3_tracker& tracker) { return tracker.frame_index; }
 
