+static struct ggml_tensor* sam3_new_owned_tensor(sam3_tracker& tracker, const sam3_model& model,
+                                                 int64_t ne0, int64_t ne1, int64_t ne2, int64_t ne3, int n_dims) {
+    struct ggml_init_params tp = {ggml_tensor_overhead(), nullptr, true};
+    struct ggml_context* ctx = ggml_init(tp);
+    auto* t = n_dims == 2 ? ggml_new_tensor_2d(ctx, GGML_TYPE_F32, ne0, ne1)
+                          : ggml_new_tensor_4d(ctx, GGML_TYPE_F32, ne0, ne1, ne2, ne3);
+    auto* b = ggml_backend_alloc_buffer(model.backend, ggml_nbytes(t));
+    struct ggml_tallocr ta = ggml_tallocr_new(b);
+    ggml_tallocr_alloc(&ta, t);
+    tracker.tensor_owners[t] = {ctx, b};
+    return t;
+}
+
+static void sam3_release_owned_tensor(sam3_tracker& tracker, const struct ggml_tensor* t) {
+    auto it = tracker.tensor_owners.find(t);
+    if (it == tracker.tensor_owners.end()) return;
+    ggml_backend_buffer_free(it->second.second);
+    ggml_free(it->second.first);
+    tracker.tensor_owners.erase(it);
+}
+
+static void sam3_release_banks(sam3_tracker& tracker, int inst_id) {
+    auto im = tracker.mem_banks.find(inst_id);
+    if (im != tracker.mem_banks.end()) {
+        for (const auto& slot : im->second) {
+            sam3_release_owned_tensor(tracker, slot.spatial_feats);
+            sam3_release_owned_tensor(tracker, slot.spatial_pe);
+        }
+        tracker.mem_banks.erase(im);
+    }
+    auto ip = tracker.ptr_banks.find(inst_id);
+    if (ip != tracker.ptr_banks.end()) {
+        for (const auto& e : ip->second) sam3_release_owned_tensor(tracker, e.second);
+        tracker.ptr_banks.erase(ip);
+    }
 }
 
