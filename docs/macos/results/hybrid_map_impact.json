{
 "question": "how much the person-mask source changes the static map (L1)",
 "status": "measured after the hand-off fixes were settled; exploratory, not an adoption rule. Measures and guide fixed before any run; the keyframe breakdown (same_keyframes_as_sam3, keyframes_used, frames_left_out_by_area_floor) was written after seeing the results",
 "machine": "Apple M4 Pro (48 GB), Metal and MPS, sam3-f16 and edgetam_f16 ggml weights, K = 4, text prompt 'person'; macOS build 26A434 for the first 4 TUM clips, 26B123 for the rest, every arm of a clip on one build; one run per arm",
 "arms": {
  "sam3": "SAM3 on every frame (reference, not ground truth)",
  "hybrid": "K = 4",
  "hybrid_drop": "K = 4, GEOMETRY_SAM3_HANDOFF_DROP_EMPTY=1"
 },
 "method": "each arm's person masks copied into a copy of the sam3 arm's l0, so cameras and depths are identical, then fuse_l0_to_l1 into a fresh L1",
 "measures": {
  "lost_static": "share of sam3-L1 points with no arm-L1 point within 2 voxels",
  "extra": "share of arm-L1 points with no sam3-L1 point within 2 voxels",
  "free_space": "share of L1 points more than 10% in front of the ground-truth surface on at least 25% of the frames where they are in view; ground-truth clips only; read as a paired difference (the sam3 baseline is high because Pi3X depth error is close to the tolerance); cannot see a stationary person"
 },
 "guide_written_beforehand": {
  "stop": "hybrid lost_static <= 1% and free_space difference <= 0.1 pp on every clip",
  "drop_empty_helps": "hybrid > 1% somewhere and hybrid_drop recovers at least half of that difference",
  "otherwise": "discuss",
  "outcome": "otherwise: above 1% on 5 clips, recovered at least half on 1"
 },
